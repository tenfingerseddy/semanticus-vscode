{
  "version": 1,
  "presses": [
    { "id": "read-source", "label": "Read the source", "say": "Your assistant pressed Read the source.", "place": "plan/start", "selector": "[data-testid=\"sp-form-start\"]", "tools": ["start_model_from_sql"] },
    { "id": "approve-build", "label": "Approve and build", "say": "Your assistant pressed Approve and build.", "place": "plan/start", "selector": "[data-testid^=\"sp-approve-build-\"]", "tools": ["approve_start_plan", "build_start_plan"] },
    { "id": "run-plan", "label": "Run the plan", "say": "Your assistant pressed Run the plan.", "place": "plan", "selector": "[data-testid=\"plan-run\"]", "tools": ["apply_plan_items"] },
    { "id": "undo", "label": "Undo", "say": "Your assistant pressed Undo.", "place": "plan", "selector": "[data-testid=\"plan-run-undo\"], [data-testid=\"said-undo\"]", "tools": ["undo_change"] },
    { "id": "save", "label": "Save", "say": "Your assistant pressed Save.", "place": "plan", "selector": "[data-testid=\"plan-run-save\"]", "tools": ["save_model"] },
    { "id": "publish", "label": "Publish", "say": "Your assistant pressed Publish.", "previewSay": "Your assistant previewed the publish.", "place": "publish/changes", "selector": "[data-testid=\"publish-go\"]", "tools": ["apply_model_diff", "deploy_live"] },
    { "id": "publish-new", "label": "Publish as a new model", "say": "Your assistant pressed Publish as a new model.", "previewSay": "Your assistant previewed the new model.", "place": "publish/new-model", "selector": "[data-testid=\"publish-go\"]", "tools": ["publish_new_model"] },
    { "id": "ask", "label": "Ask", "say": "Your assistant pressed Ask.", "place": "explore/ask", "selector": "[data-testid=\"query-ask\"]", "tools": ["ask_data"] },
    { "id": "explain", "label": "Explain", "place": "edit/queries", "selector": "[data-testid=\"explain-panel\"]", "tools": ["explain_value"] },
    { "id": "lineage", "label": "Lineage run", "place": "explore/lineage", "selector": "[data-testid=\"lineage-tree\"]", "tools": ["get_lineage", "impact_assessment"] }
  ]
}
