export declare function staticDiagram<T extends LayoutTable, R extends LayoutRel>(graph: { tables: T[]; relationships: R[] }, opts?: { aspect?: number }): { cards: StaticCard<T>[]; lines: StaticLine<R>[]; isolated: T[] };
