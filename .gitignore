# Session-internal working log (local progress notes, not a deliverable)
_session-recovery.md

# Per-developer editor cosmetics (Peacock colors, etc.)
.vscode/

# license issuance private key (never commit)
.secrets/

# Local MCP server config — holds the SEMANTICUS_DEV_PRO dev-license flag + machine-absolute paths; never commit
.mcp.json
.codex/

# Stray .daxpkg blobs saved during manual DaxLib testing (tests use in-memory bytes)
daxpkg.bin

# wrangler local state (fulfillment worker deploys) + local dev secrets for `wrangler dev`
.wrangler/
.dev.vars

# readiness-corpus local clones
tools/readiness-corpus/work/

# jev-replay generated fixtures (derived from docs/redesign/jev-pilot/verdict.json by
# `node tools/jev-replay/replay.mjs ci`, regenerated on every run; ~3.9M, never committed)
tools/jev-replay/.work/

